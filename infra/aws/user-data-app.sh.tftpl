#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker git

systemctl enable --now docker
usermod -aG docker ec2-user

fallocate -l 2G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap sw 0 0' >> /etc/fstab

mkdir -p /usr/local/lib/docker/cli-plugins
curl --fail --location \
  "https://github.com/docker/buildx/releases/download/${docker_buildx_version}/buildx-${docker_buildx_version}.linux-amd64" \
  --output /usr/local/lib/docker/cli-plugins/docker-buildx
curl --fail --location \
  "https://github.com/docker/compose/releases/download/${docker_compose_version}/docker-compose-linux-x86_64" \
  --output /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-buildx
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

install -d -o ec2-user -g ec2-user /opt/stackoverflow
git clone --branch "${repository_branch}" --single-branch "${repository_url}" /opt/stackoverflow/app
cd /opt/stackoverflow/app
echo '${compose_file_base64}' | base64 --decode > docker-compose.app.yml

cat > .env.app <<EOF
INFRA_HOST=${infrastructure_host}
MYSQL_DATABASE=stackoverflow_db
MYSQL_USER=stackoverflow_user
MYSQL_PASSWORD=${mysql_password}
APP_DEMO_SEED_ENABLED=${demo_seed_enabled}
APP_INSTANCE_INDEX=${app_index}
EOF

chmod 600 .env.app
COMPOSE_PARALLEL_LIMIT=1 docker compose --env-file .env.app -f docker-compose.app.yml up -d --build
